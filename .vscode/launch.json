{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug BOF",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/${fileDirnameBasename}.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}"
        },
        {
            "name": "Debug BOF (x64)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/x64/${fileDirnameBasename}.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}"
        },
        {
            "name": "Debug BOF (x86)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/x86/${fileDirnameBasename}.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}"
        }
    ],
    "inputs": [
    {
        "id": "arch",
        "type": "pickString",
        "description": "Architecture",
        "options": [
            "x64",
            "x86"
        ],
        "default": "x64"
    }
]
}