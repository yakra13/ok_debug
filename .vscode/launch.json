{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CaptureNetNTLM",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/capturenetntlm.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}",
            "preLaunchTask": "Build All ${input:arch} - Debug"
        },
        {
            "name": "EnumDotnet",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/enumdotnet.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}",
            "preLaunchTask": "Build All ${input:arch} - Debug"
        },
        {
            "name": "EnumDrives",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/enumdrives.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}",
            "preLaunchTask": "Build All ${input:arch} - Debug"
        },
        {
            "name": "EnumExclusions",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/enumexclusions.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}",
            "preLaunchTask": "Build All ${input:arch} - Debug"
        },
        {
            "name": "EnumFiles",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/enumfiles.exe",
            "args":[
                "${input:enumfiles_directory}",
                "${input:enumfiles_pattern}",
                "${input:enumfiles_keyword}"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}",
            "preLaunchTask": "Build All ${input:arch} - Debug"
        },
        {
            "name": "EnumHandles",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/enumhandles.exe",
            "args":[
                "${input:enumhandles_search}",
                "${input:enumhandles_query}",
                "${input:enumhandles_pid}"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}",
            "preLaunchTask": "Build All ${input:arch} - Debug"
        },
        {
            "name": "EnumLib",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/enumlib.exe",
            "args":[
                "${input:enumlib_option}",
                "${input:enumlib_module_or_pid}"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}",
            "preLaunchTask": "Build All ${input:arch} - Debug"
        },
        {
            "name": "EnumLocalCert",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/enumlocalcert.exe",
            "args":[
                "${input:enumlocalcert_store}"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}",
            "preLaunchTask": "Build All ${input:arch} - Debug"
        },
        {
            "name": "EnumRWX",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/enumrwx.exe",
            "args":[
                "${input:enumrwx_pid}"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}",
            "preLaunchTask": "Build All ${input:arch} - Debug"
        },
        {
            "name": "EnumSecProducts",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/enumsecproducts.exe",
            "args":[
                "${input:enumsecproducts_target}"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}",
            "preLaunchTask": "Build All ${input:arch} - Debug"
        },
        {
            "name": "EnumShares",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/enumshares.exe",
            "args":[
                "${input:enumshares_filepath}"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}",
            "preLaunchTask": "Build All ${input:arch} - Debug"
        },
        {
            "name": "EnumSysmon",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/enumsysmon.exe",
            "args":[
                "${input:enumsysmon_option}"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}",
            "preLaunchTask": "Build All ${input:arch} - Debug"
        },
        {
            "name": "EnumTaskScheduler",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${input:arch}/enumtaskscheduler.exe",
            "args":[
                "${input:enumtaskscheduler_target}",
                "${input:enumtaskscheduler_recurse}"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}",
            "preLaunchTask": "Build All ${input:arch} - Debug"
        },
    ],
    "inputs": [
        {
            "id": "arch",
            "type": "pickString",
            "description": "Architecutre to use.",
            "options": ["x86", "x64"],
            "default": "x64"
        },
        //------------------------------------------------------------------------------
        // EnumFiles Args
        //------------------------------------------------------------------------------
        {
            "id": "enumfiles_directory",
            "type": "promptString",
            "description": "Directory to search",
            "default": ""
        },
        {
            "id": "enumfiles_pattern",
            "type": "promptString",
            "description": "Pattern to search for. Supports wildcard.",
            "default": ""
        },
        {
            "id": "enumfiles_keyword",
            "type": "promptString",
            "description": "Keyword to search for in text files. Optional",
            "default": ""
        },
        //------------------------------------------------------------------------------
        // EnumHandles Args
        //------------------------------------------------------------------------------
        {
            "id": "enumhandles_search",
            "type": "pickString",
            "description": "Search all processes; handles to a specific process; handles of a specific process",
            "options": ["all", "h2p", "p2h"],
            "default": "all"
        },
        {
            "id": "enumhandles_query",
            "type": "pickString",
            "description": "Search for process type handles or thread type handles.",
            "options": ["proc", "thread"],
            "default": "proc"
        },
        {
            "id": "enumhandles_pid",
            "type": "promptString",
            "description": "Target PID - Required when using h2p or p2h",
            "default": "0"
        },
        //------------------------------------------------------------------------------
        // EnumLib Args
        //------------------------------------------------------------------------------
        {
            "id": "enumlib_option",
            "type": "pickString",
            "description": "Search all processes; handles to a specific process; handles of a specific process",
            "options": ["search", "list"],
            "default": "list"
        },
        {
            "id": "enumlib_module_or_pid",
            "type": "promptString",
            "description": "Target module name (search) or PID (list)",
            "default": "0"
        },
        //------------------------------------------------------------------------------
        // EnumLocalCert Args
        //------------------------------------------------------------------------------
        {
            "id": "enumlocalcert_store",
            "type": "promptString",
            "description": "ex: ROOT, MY, TRUST, CA, USERDS, AuthRoot, Disallowed",
            "default": "ROOT"
        },
        //------------------------------------------------------------------------------
        // EnumRWX Args
        //------------------------------------------------------------------------------
        {
            "id": "enumrwx_pid",
            "type": "promptString",
            "description": "process pid to enumerate",
        },
        //------------------------------------------------------------------------------
        // EnumSecProducts Args
        //------------------------------------------------------------------------------
        {
            "id": "enumsecproducts_target",
            "type": "promptString",
            "description": "FQDN or IP of target host or empty for local",
        },
        //------------------------------------------------------------------------------
        // EnumShares Args
        //------------------------------------------------------------------------------
        {
            "id": "enumshares_filepath",
            "type": "promptString",
            "description": "Path to file containing hostname targets",
            "default": "kit/EnumShares/testing.txt"
        },
        //------------------------------------------------------------------------------
        // EnumSysmon Args
        //------------------------------------------------------------------------------
        {
            "id": "enumsysmon_option",
            "type": "pickString",
            "description": "Search registry or list minifilter drivers(req elevated privs)",
            "options": ["reg", "driver"],
            "default": "reg"
        },
        //------------------------------------------------------------------------------
        // EnumTaskScheduler Args
        //------------------------------------------------------------------------------
        {
            "id": "enumtaskscheduler_target",
            "type": "promptString",
            "description": "Target fqdn to enumerate, empty for local host.",
            "default": ""
        },
        {
            "id": "enumtaskscheduler_recurse",
            "type": "pickString",
            "description": "true list all tasks false list root tasks",
            "options": ["true", "false"],
            "default": "false"
        },
    ]
}

 