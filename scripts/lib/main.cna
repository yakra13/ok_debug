# Description
$SUPPORTS_FILE_OUT_MESSAGE = "Supports writing to file:\n" .
"  Output to file only:\n" .
"    \c7command <args>\o \c9> <path/to/folder/>\o\n" .
"    \c7command <args>\o \c9>> <path/to/folder/>\o\n" .
"  Output to file and console:\n" .
"    \c7command <args>\o \c9>| <path/to/folder/>\o\n" .
"    \c7command <args>\o \c9>>| <path/to/folder/>\o\n" .
"\n";

$CMD_REDIRECT_STDOUT = 1;
$CMD_APPEND_FILE = 2;
$CMD_OUT_CONSOLE = 4;

%REDIRECT_LOOKUP = %(
    >   => $CMD_REDIRECT_STDOUT,
    >>  => $CMD_REDIRECT_STDOUT | $CMD_APPEND_FILE,
    >|  => $CMD_REDIRECT_STDOUT | $CMD_OUT_CONSOLE,
    >>| => $CMD_REDIRECT_STDOUT | $CMD_OUT_CONSOLE | $CMD_APPEND_FILE
);

beacon_command_group(
    "operatorskit",
    "OperatorsKit",
    "TODO: Add brief description of operators kit"
);

sub check_file_exists
{
    local('$file_path $fp');

    ($file_path) = @_;

    $fp = [new java.io.File: $file_path];

    if ([$fp exists])
    {
        return 1;
    }

    return 0;
}

sub parse_command
{
    local('$bid %result @command @args @tokens');
    local('$arch $flags $file_path');
    local('$i $token');

    @command = @_[0];
    $bid = (@command);
    $arch = "";
    $flags = 0;
    $file_path = "";
    @args = @();
    @tokens = sublist(@command, 1);
    %result = %();

    for ($i = 0; $i < size(@tokens); $i++)
    {
        $token = @tokens[$i];

        if ($token eq "ARCH_x86")
        {
            $arch = "x86";
            continue;
        }
        else if($token eq "ARCH_x64")
        {
            $arch = "x64";
            continue;
        }

        if (%REDIRECT_LOOKUP[$token] !is $null)
        {
           if ($i + 1 >= size(@tokens))
            {
                berror($bid, "Missing folder path after '" . $token . "'");
                return $null;
            }

            $flags |= %REDIRECT_LOOKUP[$token];
            $file_path = @tokens[$i + 1];

            if (substr($file_path, -1) !eq "/")
            {
                $file_path .= "/"
            }

            break;
        }
        else
        {
            push(@args, $token);
        }
    }

    %result["args"]  = @args;
    %result["flags"] = $flags;
    %result["file"]  = $file_path;
    %result["arch"]  = $arch;

    return %result;
}

sub generate_file_name
{
    local('$bid $path $name');
    local('%info $source $timestamp $full_path');

    ($bid, $path, $name) = (@_);

    %info      = beacon_info($bid);
    $source    = $bid;
    $timestamp = formatDate("yyyyMMddHHmm");

    if (%info["computer"] ne "")
    {
        $source = %info["computer"];
    }
    else if (%info["host"] ne "")
    {
        $source = %info["host"];
    }

    if (substr($path, -1) !eq "/")
    {
        $path .= "/"
    }

    $full_path = $path . $timestamp . "_" . $source . "_" . $name . ".yml";

    return $full_path;
}

sub handle_output
{
    local('$bid $output %info %cmd');
    local('$mode $fh');
    local('$redirect $echo $append');

    ($bid, $output, %info, %cmd) = @_;

    $fh = $null;
    $mode = ">>"; # Always append to handle multiple callbacks

    $redirect = (%cmd["flags"] & $CMD_REDIRECT_STDOUT);
    $echo     = (%cmd["flags"] & $CMD_OUT_CONSOLE);
    $append   = (%cmd["flags"] & $CMD_APPEND_FILE);

    # Handle non-output callbacks immediately.
    if (%info["type_id"] == 0x0d) # eq "error")
    {
        berror($bid, $output);
        return;
    }

    # Ignore callback types we don't explicitly handle.
    if ((!$redirect) || (%info["type_id"] ne 0x00)) # "output"))
    {
        blog($bid, "\n" . $output);
        return;
    }

    # A redirect was requested but no file path was supplied.
    if (%cmd["file"] eq "")
    {
        berror($bid, "No output path specified. Writing to console instead.");
        blog($bid, "\n" . $output);
        return;
    }

    # Attempt to write the output.
    $fh = openf($mode . %cmd["file"]);

    if ($fh is $null)
    {
        berror($bid, "Unable to open file: " . %cmd["file"]);
        berror($bid, "Writing output to the console instead.");

        blog($bid, "\n" . $output);
        return;
    }

    writeb($fh, $output);
    closef($fh);

    blog($bid, "Output written to file: " . %cmd["file"]);

    # Optionally echo redirected output to the console.
    if ($echo)
    {
        blog($bid, "\n" . $output);
    }
}

sub handle_output_beacon_inline_execute
{
    local('$bid $bof $entry %cmd $args');
    local('$x64_path $x86_path $local_path');
    local('$resolved_path');

    ($bid, $bof, $entry, %cmd, $args) = @_;
    
    $x64_path   = script_resource("x64/" . $bof);
    $x86_path   = script_resource("x86/" . $bof);
    $local_path = script_resource($bof);


    if (%cmd["arch"] eq "x64")
    {
        # x64 path was specified by user
        $resolved_path = $x64_path;
    }
    else if (%cmd["arch"] eq "x86")
    {
        # x86 path was specified by user
        $resolved_path = $x86_path;
    }
    else
    {
        # No path specified
        # Check next to script then x64 folder
        if (check_file_exists($local_path) == 0)
        {
            if (check_file_exists($x64_path) == 0)
            {
                berror($bid,
                    "Could not find BOF in default paths:\n" .
                    "  " . $local_path . "\n" .
                    "  " . $x64_path);

                return;
            }
            else
            {
                $resolved_path = $x64_path;
            }
        }
        else
        {
            $resolved_path = $local_path;
        }
    }

    if (check_file_exists($resolved_path) == 0)
    {
        berror($bid, "Could not find BOF: " . $resolved_path);
        return;
    }

    $handle = openf($resolved_path);

    if ($handle is $null)
    {
        berror($bid, "Failed to open BOF: " . $resolved_path);
        return;
    }

    $data = readb($handle, -1);
    closef($handle);

    # Create callback function to handle output
    $callback = lambda({
        local('$cbid $output %info');

        ($cbid, $output, %info) = @_;

        handle_output($cbid, $output, %info, $cmd);
    }, $cmd => %cmd);

    beacon_inline_execute(
        $bid,
        $data,
        $entry,
        $args,
        $callback
    );
}

