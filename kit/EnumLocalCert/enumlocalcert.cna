# author REDMED-X

beacon_command_register(
	"enumlocalcert",
	"List all the stored local computer certificates from a specific store.",
	"INFO:\n" .
	"  List all the stored local computer certificates from a specific store.\n" .
	"  Common store names are: ROOT, MY, TRUST, CA, USERDS, AuthRoot, Disallowed.\n\n" .
	"ARGUMENTS:\n" .
	"  [<store name>]: the name of the certificate store.\n\n" .
	"USAGE:\n" .
	"  enumlocalcert <store name>\n\n" .
	"EXAMPLES:\n" .
	"  enumlocalcert ROOT\n\n",
	"operatorskit"
);
	
alias enumlocalcert
{
	local('$bid %cmd $arg_data $bof_path $output_name');
    local('$store');

    ($bid) = @_;

    $bof_path    = "enumlocalcert.o";
	$output_name = "enum_local_cert";

    %cmd = parse_command(@_);

    if (%cmd is $null)
    {
        berror($bid, "Error parsing command\n");
        return;
    }

    %cmd["file"] = generate_file_name($bid, %cmd["file"], $output_name);

    $store = %cmd["args"][0];

    #
    # Validation
    #

	if ($store eq "")
	{
		berror($bid, "Please specify a valid local computer certificate store name like ROOT.\n");
		return;
	}
	
	#
    # Pack arguments
    #

    $arg_data  = bof_pack($bid, "Z", $store);

	blog($bid, "Tasked to list certificates from the local computer store...");

	handle_output_beacon_inline_execute($bid, $bof_path, "go", %cmd, $arg_data);
}

