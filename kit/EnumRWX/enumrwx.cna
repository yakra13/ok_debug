# author REDMED-X

beacon_command_register(
    "enumrwx", 
    "Enumerate RWX memory regions in a target process.",
    "INFO:\n" .
    "  Find processes that already have memory allocated for read/write/execute (like most .NET processes)\n\n" .
    "OPTIONS:\n" .
    "[pid]: target process to enumerate\n\n" .
    "USAGE:\n" .
    "  enumrwx <pid>\n\n",
    "operatorskit"
);

alias enumrwx
{
    local('$bid %cmd $arg_data $bof_path $output_name');
    local('$pid');

    ($bid) = @_;

    $bof_path    = "enumrwx.o";
	$output_name = "enum_rwx";

    %cmd = parse_command(@_);

    if (%cmd is $null)
    {
        berror($bid, "Error parsing command\n");
        return;
    }

    %cmd["file"] = generate_file_name($bid, %cmd["file"], $output_name);

    $pid = %cmd["args"][0];

    #
    # Validation
    #

    if ($pid eq "")
    {
        berror($bid, "Please make sure that the PID of the target process is specified.");
        return;
    }

    #
    # Pack our arguments
    #

    $arg_data  = bof_pack($bid, "i", $pid);

    blog($bid, "Tasked to verify if the target process has RWX memory regions..");

    handle_output_beacon_inline_execute($bid, $bof_path, "go", %cmd, $arg_data);
}


