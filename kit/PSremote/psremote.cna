# author REDMED-X

beacon_command_register(
    "psremote",
    "\c0List all running processes on a remote host.\o",
    "\c7Get a list of all processes running on the remote host.\o\n\n" .
    "USAGE:\n" . 
    "  psremote <FQDN or IP remote host>\n",
    "operatorskit"
);


alias psremote
{
    local('$bid %cmd $arg_data $remote_host');
    local('$bof_path $pack_fmt $output_name');

    ($bid) = @_;

    $bof_path = "psremote.o";
    $pack_fmt = "z";
    $output_name = "remote_process_list";

    %cmd = parse_command(@_);

    if (%cmd is $null)
    {
        berror($bid, "Error parsing command\n");
        return;
    }

    %cmd["file"] = generate_file_name($bid, %cmd["file"], $output_name);

    $remote_host = %cmd["args"][0];;

    if ($remote_host eq "")
    {
        berror($bid, "Remote host not specified.");
        return;
    }

    # pack our arguments
    $arg_data = bof_pack($bid, $pack_fmt, $remote_host);

    # # read in the right BOF file
    # $handle = openf(script_resource("psremote.o"));
    # $data = readb($handle, -1);
    # closef($handle);


    blog($bid, "Tasked to list running processes on remote target: " . $remote_host);
    # beacon_inline_execute($bid, $data, "go", $arg_data);

    handle_output_beacon_inline_execute(
        $bid,
        $bof_path,
        "go",
        %cmd,
        $arg_data
    );
}

