beacon_command_register(
	"enumdrives",
    "\c0Enumerate drive letters and its type.\o",
    "\c7Enumerate drive letters and its type.\o\n\n" .
	
    "USAGE:\n" .
    "  enumdrives\n\n",
    "operatorskit"
);
	
alias enumdrives
{
    local('$bid %cmd $arg_data $bof_path $output_name');

    ($bid) = @_;

    $bof_path    = "enumdrives.o";
	$output_name = "enum_drives";

    %cmd = parse_command(@_);

    if (%cmd is $null)
    {
        berror($bid, "Error parsing command\n");
        return;
    }

    %cmd["file"] = generate_file_name($bid, %cmd["file"], $output_name);

    # Pack our arguments
	$arg_data  = bof_pack($bid);

	blog($bid, "Tasked to enumerate drive letters and its type..");
    
    handle_output_beacon_inline_execute($bid, $bof_path, "go", %cmd, $arg_data);
}
