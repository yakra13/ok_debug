beacon_command_register(
	"enumexclusions",
    "\c0Check the AV for excluded files, folders, extentions and processes.\o",
    "\c7Check the AV for excluded files, folders, extentions and processes. Currently only Windows Defender exclusions are supported.\o\n\n" .
	
    "USAGE:\n" .
    "  enumexclusions\n\n",
    "operatorskit"
);
	
alias enumexclusions
{
    local('$bid %cmd $arg_data $bof_path $output_name');

    ($bid) = @_;

    $bof_path    = "enumexclusions.o";
	$output_name = "enum_exclusions";

    %cmd = parse_command(@_);

    if (%cmd is $null)
    {
        berror($bid, "Error parsing command\n");
        return;
    }

    %cmd["file"] = generate_file_name($bid, %cmd["file"], $output_name);

    # Pack our arguments
    $arg_data  = bof_pack($bid);

    blog($bid, "Tasked to enumerate exclusions..");
    
    handle_output_beacon_inline_execute($bid, $bof_path, "go", %cmd, $arg_data);
}
