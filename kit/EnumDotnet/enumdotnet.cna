beacon_command_register(
    "enumdotnet",
    "\c0Find processes that most likely have .NET loaded.\o",
    "\c7Find processes that most likely have .NET loaded by searching for the section name:\n\o" .
    "\c7      \\BaseNamedObjects\\Cor_Private_IPCBlock(_v4)_<ProcessId>\o\n\n" .
    
    "USAGE:\n" .
    "  enumdotnet\n\n",
    "operatorskit"
);

alias enumdotnet
{
    local('$bid %cmd $arg_data $bof_path $output_name');

    ($bid) = @_;

    $bof_path    = "enumdotnet.o";
	$output_name = "enum_dotnet";

    %cmd = parse_command(@_);

    if (%cmd is $null)
    {
        berror($bid, "Error parsing command\n");
        return;
    }

    %cmd["file"] = generate_file_name($bid, %cmd["file"], $output_name);
    
    blog($bid, "Tasked to search for processes that have .NET loaded..");

    handle_output_beacon_inline_execute($bid, $bof_path, "go", %cmd, $null);
}
