# author REDMED-X

beacon_command_register(
	"enumshares",
	"List remote shares and there access level using a predefined list with hostnames.",
	"INFO:\n" .
	"  List remote shares and there access level based on a list with predefined hostnames or IP addresses.\n" .
	"  The list is loaded from your own attacker system.\n\n" .
	"ARGUMENTS:\n" .
	"  [<path to file>]: The path on your own attacker system to the file containing the list with predefined hostnames.\n" .
	"                    Each hostname must be newline separated.\n\n" .
	"USAGE:\n" .
	"  enumshares <path to hostname file>\n\n" .
	"EXAMPLES:\n" .
	"  enumshares C:\\Users\\RTO\\Documents\\hostnames.txt\n\n",
	"operatorskit"
);
	
alias enumshares
{
	local('$bid %cmd $arg_data $bof_path $output_name');
    local('$path $handle $file');

    ($bid) = @_;

    $bof_path    = "enumshares.o";
	$output_name = "enum_shares";

    %cmd = parse_command(@_);

    if (%cmd is $null)
    {
        berror($bid, "Error parsing command\n");
        return;
    }

    %cmd["file"] = generate_file_name($bid, %cmd["file"], $output_name);

    $path = %cmd["args"][0];

	#
    # Validation
    #
	
	if ($path eq "")
	{
		berror($bid, "Please specify the path on your own attacker system to the file containing the list with newline separated hostnames.\n");
		return;
	}

	#
	# Pack arguments
	#

	# read in the .txt file
	$handle = openf("$path");
	$file = readb($handle, -1);
	closef($handle);
	
	blog($bid, "path: $+  $path");
	
    $arg_data = bof_pack($bid, "b", $file);

	blog($bid, "Tasked to enumerate remote shares...");

	handle_output_beacon_inline_execute($bid, $bof_path, "go", %cmd, $arg_data);
}
